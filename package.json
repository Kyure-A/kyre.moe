{
  "name": "kyre.moe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "panda codegen",
    "prelint": "panda codegen",
    "prebuild": "panda codegen && pnpm content",
    "panda": "panda codegen",
    "dev": "node scripts/dev.mjs",
    "build": "rshono build && node scripts/finalize-static.mjs",
    "start": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "check:static": "node scripts/check-static.mjs",
    "content": "node scripts/export-org.mjs && node scripts/copy-blog-images.mjs && node scripts/prepare-content.ts",
    "watch:content": "node scripts/watch-content.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint:actions": "actionlint",
    "security:semgrep": "semgrep scan --config p/default --error --metrics=off .",
    "build:framework": "rshono build && node scripts/finalize-static.mjs",
    "check:transitions": "node scripts/check-transitions.mjs",
    "check:interactions": "node scripts/check-interactions.mjs"
  },
  "dependencies": {
    "@ox-content/napi": "^3.2.13",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "ogl": "^1.0.11",
    "sanitize-html": "^2.18.0",
    "three": "^0.186.1",
    "uniorg-parse": "^3.2.2",
    "hono": "4.13.11",
    "@rshono/core": "1.0.0-rc.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "@react-spring/web": "^10.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@pandacss/dev": "^1.12.1",
    "@takumi-rs/core": "2.14.0",
    "@types/node": "26.6.3",
    "@types/sanitize-html": "^2.16.2",
    "@types/three": "^0.186.0",
    "playwright-core": "1.63.0",
    "typescript": "^5.9.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss-loader": "8.2.1",
    "csstype": "3.2.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.15",
      "ws": "^8.21.0"
    },
    "patchedDependencies": {
      "@rshono/core@1.0.0-rc.23": "patches/@rshono__core@1.0.0-rc.23.patch"
    }
  }
}
